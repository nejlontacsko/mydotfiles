{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
        "type": "builtin",
        "color": {
          "1": "blue",
          "2": "blue",
          "3": "blue",
          "4": "blue",
          "5": "blue"
        },
        "padding": {
          "top": 1,
          "left": 2,
          "right": 4
        }
    },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────────────Hardware────────────────────────────┐",
      "outputColor": "magenta"
    },
    {
      "type": "host",
      "key": "│ HOST",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "display",
      "key": "│ ├ Display",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "cpu",
      "key": "│ ├ CPU",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "gpu",
      "key": "│ ├ GPU",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "memory",
      "key": "│ ├ MEM",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "swap",
      "key": "│ │ └ Swap",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "disk",
      "key": "│ ├ Disk",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "battery",
      "key": "│ └ Battery",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "poweradapter",
      "key": "    └ Poweradapter",
      "keyColor": "magenta",
      "outputColor": "blue"
    },

    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────────────┘",
      "outputColor": "magenta"
    },
    "break",
    {
      "type": "custom",
      "format": "┌────────────────────────────Software────────────────────────────┐",
      "outputColor": "magenta"
    },
    {
      "type": "os",
      "key": "│ OS",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├ Packages",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ ├ Shell",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "de",
      "key": "│ ├ DE",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├ Terminal",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│ ├ Uptime",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "localip",
      "key": "│ └ Local IP",
      "keyColor": "magenta",
      "outputColor": "blue"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────────────┘",
      "outputColor": "magenta"
    },
    
    "break",
    "colors",
    "break"
  ]
}
